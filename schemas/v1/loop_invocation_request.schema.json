{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontoos.dev/schemas/v1/loop_invocation_request.schema.json",
  "title": "LoopInvocationRequest",
  "description": "Go OntoFlow → Rust OntoLoop Worker request. Go sends references, not content.",
  "type": "object",
  "required": [
    "schema_version", "flow_id", "work_item_id", "loop_id",
    "task_spec_ref", "contract_ref", "policy_ref",
    "execution_generation", "idempotency_key",
    "request_binding_hash"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "flow_id": { "type": "string", "minLength": 1 },
    "work_item_id": { "type": "string", "minLength": 1 },
    "loop_id": { "type": "string", "minLength": 1 },
    "task_spec_ref": { "type": "string", "minLength": 1 },
    "contract_ref": { "type": "string", "minLength": 1 },
    "policy_ref": { "type": "string", "minLength": 1 },
    "input_artifact_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "resource_class": { "type": "string", "default": "standard" },
    "risk_class": { "type": "string", "default": "low" },
    "trust_requirement": { "type": "string", "default": "basic" },
    "budget_grant_ref": { "type": "string" },
    "budget_grant_hash": { "type": "string" },
    "execution_generation": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "deadline": { "type": "string", "format": "date-time" },
    "request_binding_hash": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
